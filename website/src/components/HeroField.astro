---
// The hero's background: the dot grid, drawn by a WebGL shader, with a slow
// noise field lighting patches of dots blue, brightest around the platforms'
// board. Each time a platform is lit, a ring of lit dots spreads out from
// its tile and fades. Near the pointer the dots light up and part around it.
// The grid fades under the copy's words so they keep a quiet ground.
// Without WebGL, the CSS dots of `.hero__glow` stay; with less motion asked
// for, one still frame is drawn. Either way the glow centres on the board.
---

<canvas class="hero-field" aria-hidden="true"></canvas>

<script>
  const vertex = `
    attribute vec2 position;
    void main() {
      gl_Position = vec4(position, 0.0, 1.0);
    }
  `;

  // Works in CSS pixels so the grid matches the 22-pixel CSS dots it
  // replaces. Outputs premultiplied alpha over the page's background.
  const fragment = `
    precision highp float;
    uniform vec2 size;
    uniform float scale;
    uniform float time;
    uniform vec3 dotColor;
    uniform vec3 accent;
    uniform float strength;
    uniform vec2 pointer;
    uniform float reach;
    uniform vec4 quiet;
    uniform vec3 focus;
    uniform vec4 ripples[2];

    const float cell = 22.0;

    float hash(vec2 p) {
      p = fract(p * vec2(123.34, 456.21));
      p += dot(p, p + 45.32);
      return fract(p.x * p.y);
    }

    float noise(vec3 p) {
      vec3 i = floor(p);
      vec3 f = fract(p);
      f = f * f * (3.0 - 2.0 * f);
      vec2 o = vec2(i.z * 17.0, i.z * 31.0);
      float a = mix(mix(hash(i.xy + o), hash(i.xy + vec2(1.0, 0.0) + o), f.x),
                    mix(hash(i.xy + vec2(0.0, 1.0) + o), hash(i.xy + vec2(1.0, 1.0) + o), f.x), f.y);
      o += vec2(17.0, 31.0);
      float b = mix(mix(hash(i.xy + o), hash(i.xy + vec2(1.0, 0.0) + o), f.x),
                    mix(hash(i.xy + vec2(0.0, 1.0) + o), hash(i.xy + vec2(1.0, 1.0) + o), f.x), f.y);
      return mix(a, b, f.z);
    }

    float fbm(vec3 p) {
      float sum = 0.0;
      float amp = 0.5;
      for (int i = 0; i < 4; i++) {
        sum += amp * noise(p);
        p = p * 2.03 + vec3(1.7, 9.2, 0.0);
        amp *= 0.5;
      }
      return sum;
    }

    // A ring spreading from a lit platform's tile: its centre, the tile's
    // half size it starts at and its age in seconds.
    float ripple(vec4 r, vec2 at) {
      float age = r.w;
      if (age < 0.0 || age > 4.0) return 0.0;
      float radius = r.z + age * 210.0;
      float band = (length(at - r.xy) - radius) / 34.0;
      float fade = smoothstep(0.0, 0.25, age) * exp(-age * 0.9);
      return exp(-band * band) * fade;
    }

    void main() {
      vec2 p = vec2(gl_FragCoord.x, size.y - gl_FragCoord.y) / scale;
      vec2 id = floor(p / cell + 0.5);

      // The pointer lights the dots around it and pushes them a little
      // outward, as through a lens.
      vec2 away = id * cell - pointer;
      float gap = length(away);
      float near = reach * exp(-gap * gap / 60000.0) * 0.5;
      vec2 offset = p - id * cell - away / max(gap, 1.0) * near * 4.0;
      float d = length(offset);

      // A slow field drifting across the grid.
      float field = fbm(vec3(id * 0.07 + vec2(time * 0.12, 0.0), time * 0.08));
      float patch = smoothstep(0.48, 0.72, field);
      vec2 fromFocus = (p - focus.xy) / focus.z;
      patch *= mix(0.3, 1.0, exp(-dot(fromFocus, fromFocus)));

      float ring = max(ripple(ripples[0], id * cell), ripple(ripples[1], id * cell));

      // Faint under the copy's words, brightening gradually from inside
      // their box to well past its edge.
      vec2 q = abs(p - quiet.xy) - quiet.zw;
      float outside = length(max(q, 0.0)) + min(max(q.x, q.y), 0.0);
      float calm = mix(0.3, 1.0, smoothstep(-48.0, 180.0, outside));

      float lit = max(max(patch * 0.45, ring * 0.8), near);

      // Lit dots grow and glow.
      float radius = 0.55 + lit * 0.5;
      float dotMask = 1.0 - smoothstep(radius, radius + 0.8, d);
      float glow = exp(-d * d / 10.0) * lit * 0.18;

      float base = dotMask * strength * mix(1.0, 1.0 / max(strength, 0.01), lit);
      vec3 color = mix(dotColor, accent, lit);
      float alpha = min(base + glow * (1.0 - dotMask), 1.0);
      vec3 rgb = color * base + accent * glow * (1.0 - dotMask);
      gl_FragColor = vec4(rgb, alpha) * calm;
    }
  `;

  // The box around the copy's words, its text and buttons, which is
  // narrower than the column holding them.
  const words = (hero: HTMLElement): DOMRect | null => {
    const copy = hero.querySelector('.hero__copy');
    if (!copy) return null;
    const rects: DOMRect[] = Array.from(copy.querySelectorAll('.pill, .btn'), (element) => element.getBoundingClientRect());
    const walker = document.createTreeWalker(copy, NodeFilter.SHOW_TEXT);
    const range = document.createRange();
    for (let node = walker.nextNode(); node; node = walker.nextNode()) {
      if (!node.textContent?.trim() || node.parentElement?.closest('.pill, .btn')) continue;
      range.selectNodeContents(node);
      rects.push(...Array.from(range.getClientRects()));
    }
    if (!rects.length) return null;
    const left = Math.min(...rects.map((rect) => rect.left));
    const top = Math.min(...rects.map((rect) => rect.top));
    const right = Math.max(...rects.map((rect) => rect.right));
    const bottom = Math.max(...rects.map((rect) => rect.bottom));
    return new DOMRect(left, top, right - left, bottom - top);
  };

  // Centres the CSS glow on the platforms' board, with or without WebGL.
  const glow = (hero: HTMLElement) => {
    const layer = hero.querySelector<HTMLElement>('.hero__glow');
    const board = hero.querySelector('.tiles');
    if (!layer || !board) return;
    const place = () => {
      const box = layer.getBoundingClientRect();
      const rect = board.getBoundingClientRect();
      layer.style.setProperty('--glow-x', `${rect.left - box.left + rect.width / 2}px`);
      layer.style.setProperty('--glow-y', `${rect.top - box.top + rect.height / 2}px`);
    };
    new ResizeObserver(place).observe(hero);
    place();
  };

  const canvas = document.querySelector<HTMLCanvasElement>('.hero-field');
  const heroElement = document.querySelector<HTMLElement>('.hero');
  if (heroElement) glow(heroElement);
  const gl = canvas?.getContext('webgl', { alpha: true, premultipliedAlpha: true, antialias: false });

  const compile = (gl: WebGLRenderingContext, type: number, source: string) => {
    const shader = gl.createShader(type)!;
    gl.shaderSource(shader, source);
    gl.compileShader(shader);
    return gl.getShaderParameter(shader, gl.COMPILE_STATUS) ? shader : null;
  };

  // Resolves a CSS color, such as a custom property, to 0–1 RGB.
  const probe = document.createElement('span');
  const rgb = (value: string): [number, number, number] => {
    probe.style.color = value;
    document.body.append(probe);
    const parts = getComputedStyle(probe).color.match(/[\d.]+/g)?.map(Number) ?? [0, 0, 0];
    probe.remove();
    return [parts[0]! / 255, parts[1]! / 255, parts[2]! / 255];
  };

  const start = (canvas: HTMLCanvasElement, gl: WebGLRenderingContext) => {
    const vs = compile(gl, gl.VERTEX_SHADER, vertex);
    const fs = compile(gl, gl.FRAGMENT_SHADER, fragment);
    if (!vs || !fs) return;
    const program = gl.createProgram()!;
    gl.attachShader(program, vs);
    gl.attachShader(program, fs);
    gl.linkProgram(program);
    if (!gl.getProgramParameter(program, gl.LINK_STATUS)) return;
    gl.useProgram(program);

    gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const position = gl.getAttribLocation(program, 'position');
    gl.enableVertexAttribArray(position);
    gl.vertexAttribPointer(position, 2, gl.FLOAT, false, 0, 0);

    const uniform = (name: string) => gl.getUniformLocation(program, name);
    const size = uniform('size');
    const scale = uniform('scale');
    const time = uniform('time');
    const dotColor = uniform('dotColor');
    const accent = uniform('accent');
    const strength = uniform('strength');
    const pointer = uniform('pointer');
    const reach = uniform('reach');
    const quiet = uniform('quiet');
    const focus = uniform('focus');
    const ripplesAt = uniform('ripples');

    const hero = canvas.closest<HTMLElement>('.hero');
    const still = window.matchMedia('(prefers-reduced-motion: reduce)');
    const origin = performance.now() - 40_000;
    let frame = 0;
    let visible = true;

    // The pointer's place in the canvas and how much it shows, eased
    // towards where it is and whether it is over the hero.
    const target = { x: 0, y: 0, reach: 0 };
    const rings = [
      { x: 0, y: 0, r: 0, start: -1e9 },
      { x: 0, y: 0, r: 0, start: -1e9 },
    ];
    const eased = { x: 0, y: 0, reach: 0 };

    const draw = (now: number) => {
      frame = 0;
      const moving = !still.matches;
      const ease = moving ? 0.035 : 1;
      eased.x += (target.x - eased.x) * ease;
      eased.y += (target.y - eased.y) * ease;
      eased.reach += (target.reach - eased.reach) * ease;
      const settled = Math.abs(target.x - eased.x) + Math.abs(target.y - eased.y) < 0.5 && Math.abs(target.reach - eased.reach) < 0.005;
      gl.uniform1f(time, moving ? (now - origin) / 1000 : 40);
      gl.uniform2f(pointer, eased.x, eased.y);
      gl.uniform1f(reach, eased.reach);
      // The latest ring and the one before it, which is still fading.
      gl.uniform4fv(ripplesAt, rings.flatMap((ring) => [ring.x, ring.y, ring.r, moving ? (now - ring.start) / 1000 : -1]));
      gl.drawArrays(gl.TRIANGLES, 0, 3);
      if (visible && !document.hidden && (moving || !settled)) frame = requestAnimationFrame(draw);
    };
    const redraw = () => {
      if (frame) cancelAnimationFrame(frame);
      frame = requestAnimationFrame(draw);
    };

    const colors = () => {
      const dark = document.documentElement.dataset.theme === 'dark';
      gl.uniform3fv(dotColor, rgb('var(--border-strong)'));
      gl.uniform3fv(accent, rgb('var(--blue)'));
      gl.uniform1f(strength, dark ? 0.85 : 0.9);
      redraw();
    };

    const resize = () => {
      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      const width = Math.round(canvas.clientWidth * ratio);
      const height = Math.round(canvas.clientHeight * ratio);
      if (canvas.width !== width || canvas.height !== height) {
        canvas.width = width;
        canvas.height = height;
      }
      gl.viewport(0, 0, width, height);
      gl.uniform2f(size, width, height);
      gl.uniform1f(scale, ratio);
      const box = canvas.getBoundingClientRect();
      const copy = hero ? words(hero) : null;
      if (copy) {
        gl.uniform4f(quiet, copy.left - box.left + copy.width / 2, copy.top - box.top + copy.height / 2, copy.width / 2 + 16, copy.height / 2 + 16);
      } else {
        gl.uniform4f(quiet, -1000, -1000, 0, 0);
      }
      const board = hero?.querySelector('.tiles')?.getBoundingClientRect();
      if (board) {
        gl.uniform3f(focus, board.left - box.left + board.width / 2, board.top - box.top + board.height / 2, Math.max(board.width, board.height) * 0.8);
      } else {
        gl.uniform3f(focus, box.width / 2, 260, 1e6);
      }
      redraw();
    };

    const point = (event: PointerEvent) => {
      const box = canvas.getBoundingClientRect();
      target.x = event.clientX - box.left;
      target.y = event.clientY - box.top;
      if (eased.reach < 0.01) {
        eased.x = target.x;
        eased.y = target.y;
      }
      target.reach = target.y < box.height ? 1 : 0;
      if (!frame) redraw();
    };
    // A platform's tile sends out a ring each time it is lit.
    const spread = (tile: Element) => {
      const box = canvas.getBoundingClientRect();
      const rect = tile.getBoundingClientRect();
      rings.unshift({
        x: rect.left - box.left + rect.width / 2,
        y: rect.top - box.top + rect.height / 2,
        r: Math.max(rect.width, rect.height) / 2,
        start: performance.now(),
      });
      rings.length = 2;
      if (!frame) redraw();
    };
    const lights = new MutationObserver((changes) => {
      for (const change of changes) {
        const tile = change.target as Element;
        if (tile.classList.contains('is-lit') && !change.oldValue?.includes('is-lit')) spread(tile);
      }
    });
    hero?.querySelectorAll('.platform').forEach((tile) => lights.observe(tile, { attributes: true, attributeFilter: ['class'], attributeOldValue: true }));

    hero?.addEventListener('pointermove', point);
    hero?.addEventListener('pointerdown', point);
    hero?.addEventListener('pointerleave', () => {
      target.reach = 0;
      if (!frame) redraw();
    });

    const resizes = new ResizeObserver(resize);
    resizes.observe(canvas);
    const copy = hero?.querySelector('.hero__copy');
    if (copy) resizes.observe(copy);
    new IntersectionObserver(([entry]) => {
      visible = entry!.isIntersecting;
      if (visible) redraw();
    }).observe(canvas);
    // The words' box moves once the web fonts arrive.
    document.fonts?.ready.then(resize);
    document.addEventListener('visibilitychange', () => document.hidden || redraw());
    document.addEventListener('nsgo-theme', colors);
    still.addEventListener('change', redraw);

    colors();
    resize();
    hero?.classList.add('hero--shaded');
  };

  if (canvas && gl) start(canvas, gl);
</script>
